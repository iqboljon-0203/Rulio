# Nusxa oling: .env.local (lokal) yoki Vercel → Settings → Environment Variables

# --- Majburiy ---
TELEGRAM_BOT_TOKEN=          # BotFather bergan token
SESSION_SECRET=              # 32+ belgili tasodifiy satr (cookie imzosi)
NEXT_PUBLIC_SITE_URL=https://www.rulio.uz
TELEGRAM_BOT_USERNAME=       # ixtiyoriy, masalan rulio_bot (getMe chaqiruvini tejaydi)

# --- Ma'lumotlar bazasi: Upstash Redis (Vercel Marketplace avtomatik qo'shadi) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Payme (business.payme.uz → Kassa → Sozlamalar) ---
PAYME_MERCHANT_ID=
PAYME_MERCHANT_KEY=                 # test paytida test kalit, keyin production kalit
# PAYME_CHECKOUT_URL=https://test.paycom.uz   # faqat test rejimida

# --- Click (merchant.click.uz → Servis sozlamalari) ---
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# --- Karta orqali avto-to'lov (SMS forwarder) ---
SMS_WEBHOOK_SECRET=          # 32+ belgili tasodifiy satr, SMS Forwarder URL ichiga qo'yiladi

# --- Karta va admin (ixtiyoriy, bo'lmasa koddagi qiymatlar ishlatiladi) ---
P2P_CARD_NUMBER=
P2P_CARD_HOLDER=
ADMIN_TG_ID=
ADMIN_USERNAME=dream_tech_manager
